# ════════════════════════════════════════════════════════════════
# 🔐 VARIÁVEIS DE AMBIENTE - EXEMPLO COMPLETO
# ════════════════════════════════════════════════════════════════
# 
# COPIE este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com suas chaves reais!
#
# ════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# 🔑 SEGURANÇA (OBRIGATÓRIO)
# ────────────────────────────────────────────────────────────────

# Chave secreta para JWT (OBRIGATÓRIO em produção)
# Gere com: openssl rand -hex 32 ou python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Credenciais de Admin (desenvolvimento apenas)
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=Admin123!

# ────────────────────────────────────────────────────────────────
# 🌐 CORS - Origens Permitidas
# ────────────────────────────────────────────────────────────────

# Liste os domínios permitidos separados por vírgula
# Desenvolvimento: use "*" para permitir todos
# Produção: especifique os domínios exatos
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://admin-dashboard.onrender.com,https://seudominio.com

# ────────────────────────────────────────────────────────────────
# 🤖 INTEGRAÇÕES DE IA
# ────────────────────────────────────────────────────────────────

# OpenAI API (opcional, se usar GPT)
AI_API_KEY=sk-sua-chave-openai-aqui
AI_API_URL=https://api.openai.com/v1/chat/completions

# ────────────────────────────────────────────────────────────────
# 📁 DIRETÓRIOS E ARMAZENAMENTO
# ────────────────────────────────────────────────────────────────

# Diretório de uploads (use /tmp no Render Free)
UPLOAD_FOLDER=/tmp/uploads

# Diretório de exports (use /tmp no Render Free)
EXPORT_FOLDER=/tmp/exports

# ────────────────────────────────────────────────────────────────
# 📧 EMAIL (Nodemailer/SMTP)
# ────────────────────────────────────────────────────────────────

EMAIL_USER=miguelbr981@gmail.com
EMAIL_PASS=sua_senha_de_app_aqui
EMAIL_TO=miguelbr981@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ────────────────────────────────────────────────────────────────
# 🔗 BACKEND CONFIGURATION
# ────────────────────────────────────────────────────────────────

API_URL=http://localhost:8000

# ────────────────────────────────────────────────────────────────
# 📱 WHATSAPP (opcional)
# ────────────────────────────────────────────────────────────────

WHATSAPP_API_URL=https://api.whatsapp.com/send
WHATSAPP_PHONE=5511999999999

# ────────────────────────────────────────────────────────────────
# 📊 GOOGLE SHEETS (opcional)
# ────────────────────────────────────────────────────────────────

GOOGLE_SHEETS_API_KEY=sua-chave-google-sheets-aqui
GOOGLE_SHEETS_SPREADSHEET_ID=seu-spreadsheet-id-aqui

# ────────────────────────────────────────────────────────────────
# 🗄️ DATABASE (opcional)
# ────────────────────────────────────────────────────────────────

DATABASE_URL=sqlite:///./chat.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ────────────────────────────────────────────────────────────────
# ⚙️ CONFIGURAÇÕES DA APLICAÇÃO
# ────────────────────────────────────────────────────────────────

DEBUG=False
ENVIRONMENT=production

# ════════════════════════════════════════════════════════════════
# 📝 NOTAS IMPORTANTES PARA RENDER
# ════════════════════════════════════════════════════════════════
#
# 1. SECRET_KEY é OBRIGATÓRIA em produção
#    Configure no Render: Settings > Environment > Add Environment Variable
#
# 2. ALLOWED_ORIGINS deve especificar domínios reais em produção
#    Exemplo: https://meu-frontend.onrender.com
#
# 3. Use /tmp/ para uploads no Render Free
#    Disco é efêmero (arquivos são perdidos no restart)
#
# 4. PORT é definida automaticamente pelo Render
#    Não precisa adicionar manualmente
#
# 5. Para Gmail: use Senha de Aplicativo (App Password)
#    https://support.google.com/accounts/answer/185833
#
# ════════════════════════════════════════════════════════════════
